{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "env": {
    "AGY_AUTO_ZY_VERSION": "1.0.0"
  },
  "restart_policy": "always",
  "display_name": "Auto-ZY 权限审核",
  "description": "在 Local Permissions 左侧提供 auto-zy / auto-workspace-zy 模式切换，并通过本机 Magpie DS-Flash (max) 自动审核工具调用。",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Auto-ZY 权限审核",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Auto-ZY 权限审核"
      }
    ]
  }
}
